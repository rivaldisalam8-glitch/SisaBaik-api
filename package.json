{
  "name": "sisabaik-api",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch server.js",
    "start": "node server.js",
    "start:local": "node --env-file=.env scripts/jalankan-lokal.js",
    "build": "npm --prefix frontend run build",
    "demo:cloud:init": "node --env-file=.env.cloud scripts/siapkan-demo-cloud.js",
    "deploy:test": "node scripts/uji-deployment.js",
    "db:check": "node --env-file=.env scripts/check-db.js",
    "db:order": "node --env-file=.env scripts/create-order.js",
    "api:test:chapter7": "node scripts/uji-api.js",
    "db:auth": "node --env-file=.env scripts/siapkan-auth.js",
    "auth:test": "node --env-file=.env scripts/uji-auth.js",
    "db:migrate": "node --env-file=.env scripts/migrasi-aplikasi.js",
    "db:migrate:cloud": "node --env-file=.env.cloud scripts/migrasi-aplikasi.js --cloud",
    "workflow:test": "node --env-file=.env scripts/uji-alur-transaksi.js",
    "db:init": "node --env-file=.env scripts/inisialisasi-aplikasi.js",
    "db:init:cloud": "node --env-file=.env.cloud scripts/inisialisasi-aplikasi.js --cloud",
    "penyedia:verifikasi": "node --env-file=.env scripts/verifikasi-penyedia.js",
    "penyedia:verifikasi:cloud": "node --env-file=.env.cloud scripts/verifikasi-penyedia.js --cloud"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.1.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.16.3",
    "sharp": "0.35.5"
  }
}
